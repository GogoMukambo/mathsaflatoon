# Required on Vercel (Project → Settings → Environment Variables).
# Supabase → Database → Connection string → URI (port 5432, not 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Razorpay (Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
