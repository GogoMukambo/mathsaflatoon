# Maths Aflatoon only. The rest of the website stays on local SQLite.
# Supabase → Project Settings → Database → Connection string → URI.
# Use the Session pooler or Direct connection (port 5432).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Razorpay (required for UPI QR / UPI app success → course unlock)
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Phone login texts a 6-digit code. Fill in one provider, then restart the site.
# Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Fast2SMS (India OTP route):
# FAST2SMS_API_KEY=

# Email (Focus Mode recovery codes + course welcome emails). Fill in one provider.
# Resend: https://resend.com/api-keys
# RESEND_API_KEY=
# Brevo: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=
# From address (must be allowed by the provider):
# EMAIL_FROM=Maths Aflatoon <hello@yourdomain.com>
# Optional public site URL used in welcome email course links:
# PUBLIC_BASE_URL=https://your-domain.com
# Local testing without a provider (logs the email to the server console):
# EMAIL_DEV_LOG=1
